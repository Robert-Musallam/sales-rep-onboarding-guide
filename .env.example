# ── Supabase (RNB project — see SETUP.md §1) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployed webapp (used in SMS/Teams deep links + OAuth redirect)
APP_BASE_URL=https://rnb-onboarding.vercel.app

# ── Microsoft Graph (existing RNB app registration — rotate the secret!) ────
MS_TENANT_ID=b3cd6f2e-ed00-464c-8644-6b6fca6a4b2e
MS_CLIENT_ID=1f877804-7bc1-446a-a8ea-b68ffab2c97c
MS_CLIENT_SECRET=

# 64 hex chars — encrypts the delegated refresh token at rest:  openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ── Dialpad (RNB account — rotate the key that lived in Make!) ──────────────
DIALPAD_API_KEY=

# ── Jotform (rotate the key that lived in Make!) ────────────────────────────
JOTFORM_API_KEY=

# ── Housecall Pro — default key + optional per-territory overrides ──────────
# (territories.hcp_api_key_env in Settings names which env var each territory uses)
HCP_API_KEY=
# HCP_API_KEY_TAMPA=
# HCP_API_KEY_LAS_VEGAS=

# ── Worker send gates (SAFETY: dry_run until cutover — SETUP.md §go-live) ───
RNB_AUTOMATION_MODE=dry_run
# RNB_GLOBAL_KILL_SWITCH=1
PILOT_SEND_ONLY=1
PILOT_ALLOWED_PHONES=+17025551234
PILOT_ALLOWED_EMAILS=robert@example.com
# PILOT_ALLOW_TEAMS=1
# PILOT_ALLOW_PROVISION=1

# ── Optional Slack failure alerts ───────────────────────────────────────────
# SLACK_WEBHOOK_URL=
